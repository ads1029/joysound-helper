{
  "name": "joysound-x1-helper",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.17",
  "engines": {
    "bun": ">=1.2.17",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "audit:joysound": "bun run scripts/audit-joysound.ts",
    "crawl:joysound": "bun run scripts/crawl-joysound.ts",
    "discover:expanded": "bun run scripts/discover-expanded-songs.ts",
    "discover:full-artists": "bun run scripts/discover-full-artist-songs.ts",
    "discover:joysound": "bun run scripts/discover-ranked-songs.ts",
    "promote:joysound": "bun run scripts/promote-joysound.ts",
    "review:joysound": "bun run scripts/review-joysound.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:deployment": "bun run scripts/verify-deployment.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
